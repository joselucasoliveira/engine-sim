#include <metal_stdlib>
using namespace metal;
struct VertexUniforms { float4x4 transform; float4x4 cameraView; float4x4 projection; };
struct VertexInput { float4 position [[attribute(0)]]; float2 texcoord [[attribute(2)]]; };
struct VertexOutput { float4 position [[position]]; float2 texcoord [[user(locn0)]]; };
vertex VertexOutput VSMain(VertexInput input [[stage_in]], constant VertexUniforms &u [[buffer(0)]]) {
    VertexOutput output;
    output.position = float4(input.position.xyz, 1.0) * u.transform * u.cameraView * u.projection;
    output.texcoord = input.texcoord;
    return output;
}
