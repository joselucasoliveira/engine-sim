{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "external",
      "hidden": true,
      "binaryDir": "$env{ES_OUT}/${presetName}",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{ES_OUT}",
        "rhs": ""
      },
      "cacheVariables": {
        "ENGINE_SIM_PRESET_ROOT": "$env{ES_OUT}",
        "ENGINE_SIM_DEPS_FILE": "$env{ES_OUT}/deps.cmake",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "$env{ES_OUT}/${presetName}/bin",
        "DTV": false,
        "DISCORD_ENABLED": false
      }
    },
    {
      "name": "core",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true,
        "PIRANHA_ENABLED": false,
        "ENGINE_SIM_BUILD_DESKTOP": false
      }
    },
    {
      "name": "core-release",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": true,
        "PIRANHA_ENABLED": false,
        "ENGINE_SIM_BUILD_DESKTOP": false
      }
    },
    {
      "name": "capture",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": true,
        "PIRANHA_ENABLED": true,
        "ENGINE_SIM_BUILD_DESKTOP": false,
        "ENGINE_SIM_BUILD_CAPTURE": true
      }
    },
    {
      "name": "desktop",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": true,
        "PIRANHA_ENABLED": true,
        "ENGINE_SIM_BUILD_DESKTOP": true
      }
    },
    {
      "name": "desktop-windows",
      "inherits": "desktop",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "allOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "notEquals",
            "lhs": "$env{ES_OUT}",
            "rhs": ""
          }
        ]
      }
    },
    {
      "name": "asan",
      "inherits": "capture",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "ENGINE_SIM_SANITIZER": "address"
      }
    },
    {
      "name": "tsan",
      "inherits": "capture",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "ENGINE_SIM_SANITIZER": "thread"
      }
    },
    {
      "name": "win-asan",
      "inherits": "desktop-windows",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
        "ENGINE_SIM_SANITIZER": "address",
        "ENGINE_SIM_BUILD_CAPTURE": true
      }
    },
    {
      "name": "desktop-asan",
      "inherits": "asan",
      "cacheVariables": {
        "ENGINE_SIM_BUILD_DESKTOP": true,
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "desktop-tsan",
      "inherits": "tsan",
      "cacheVariables": {
        "ENGINE_SIM_BUILD_DESKTOP": true,
        "CMAKE_C_COMPILER": "gcc"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core",
      "configurePreset": "core",
      "configuration": "Debug"
    },
    {
      "name": "core-release",
      "configurePreset": "core-release",
      "configuration": "Release"
    },
    {
      "name": "capture",
      "configurePreset": "capture",
      "configuration": "Release"
    },
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "configuration": "Release"
    },
    {
      "name": "desktop-windows",
      "configurePreset": "desktop-windows",
      "configuration": "Release"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "win-asan",
      "configurePreset": "win-asan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "desktop-asan",
      "configurePreset": "desktop-asan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "desktop-tsan",
      "configurePreset": "desktop-tsan",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "core",
      "configurePreset": "core",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 90
      }
    },
    {
      "name": "core-release",
      "configurePreset": "core-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 90
      }
    },
    {
      "name": "capture",
      "configurePreset": "capture",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 90
      }
    },
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 90
      }
    },
    {
      "name": "desktop-windows",
      "configurePreset": "desktop-windows",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 90
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "RelWithDebInfo",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 600
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "configuration": "RelWithDebInfo",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:exitcode=66"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 600
      }
    },
    {
      "name": "win-asan",
      "configurePreset": "win-asan",
      "configuration": "RelWithDebInfo",
      "environment": {},
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 600
      }
    },
    {
      "name": "desktop-asan",
      "inherits": "asan",
      "configurePreset": "desktop-asan"
    },
    {
      "name": "desktop-tsan",
      "inherits": "tsan",
      "configurePreset": "desktop-tsan",
      "filter": {
        "include": {
          "label": "desktop-audio|threaded|desktop-smoke-unit"
        }
      }
    }
  ]
}
