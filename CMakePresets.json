{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "external",
      "hidden": true,
      "binaryDir": "$env{ES_OUT}/${presetName}",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{ES_OUT}",
        "rhs": ""
      },
      "cacheVariables": {
        "ENGINE_SIM_PRESET_ROOT": "$env{ES_OUT}",
        "ENGINE_SIM_DEPS_FILE": "$env{ES_OUT}/deps.cmake",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "$env{ES_OUT}/${presetName}/bin",
        "DTV": false,
        "DISCORD_ENABLED": false
      }
    },
    {
      "name": "config",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENGINE_SIM_MODULE_PROFILE": "config",
        "ENGINE_SIM_BUILD_DESKTOP": false,
        "BUILD_TESTING": false
      }
    },
    {
      "name": "physics",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENGINE_SIM_MODULE_PROFILE": "physics",
        "ENGINE_SIM_BUILD_DESKTOP": false,
        "BUILD_TESTING": false
      }
    },
    {
      "name": "synthesis",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENGINE_SIM_MODULE_PROFILE": "synthesis",
        "ENGINE_SIM_BUILD_DESKTOP": false,
        "BUILD_TESTING": false
      }
    },
    {
      "name": "core",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true,
        "ENGINE_SIM_BUILD_DESKTOP": false
      }
    },
    {
      "name": "core-release",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": true,
        "ENGINE_SIM_BUILD_DESKTOP": false
      }
    },
    {
      "name": "capture",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": true,
        "ENGINE_SIM_BUILD_DESKTOP": false,
        "ENGINE_SIM_BUILD_CAPTURE": true
      }
    },
    {
      "name": "desktop",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": true,
        "ENGINE_SIM_BUILD_DESKTOP": true
      }
    },
    {
      "name": "desktop-windows",
      "inherits": "desktop",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "allOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Windows"
          },
          {
            "type": "notEquals",
            "lhs": "$env{ES_OUT}",
            "rhs": ""
          }
        ]
      }
    },
    {
      "name": "asan",
      "inherits": "capture",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "ENGINE_SIM_SANITIZER": "address"
      }
    },
    {
      "name": "tsan",
      "inherits": "capture",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "ENGINE_SIM_SANITIZER": "thread"
      }
    },
    {
      "name": "win-asan",
      "inherits": "desktop-windows",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
        "ENGINE_SIM_SANITIZER": "address",
        "ENGINE_SIM_BUILD_CAPTURE": true
      }
    },
    {
      "name": "desktop-asan",
      "inherits": "asan",
      "cacheVariables": {
        "ENGINE_SIM_BUILD_DESKTOP": true,
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "desktop-tsan",
      "inherits": "tsan",
      "cacheVariables": {
        "ENGINE_SIM_BUILD_DESKTOP": true,
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "runtime",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false,
        "ENGINE_SIM_BUILD_RUNTIME": true,
        "ENGINE_SIM_BUILD_HOST_TESTS": false,
        "ENGINE_SIM_BUILD_DESKTOP": false,
        "ENGINE_SIM_BUILD_CAPTURE": false
      }
    },
    {
      "name": "legacy-converter",
      "inherits": "external",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": false,
        "ENGINE_SIM_BUILD_LEGACY_CONVERTER": true,
        "ENGINE_SIM_BUILD_DESKTOP": false,
        "ENGINE_SIM_BUILD_RUNTIME": false,
        "ENGINE_SIM_BUILD_CAPTURE": false,
        "ENGINE_SIM_BUILD_HOST_TESTS": false
      }
    },
    {
      "name": "runtime-test",
      "inherits": "runtime",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "ENGINE_SIM_BUILD_RUNTIME_EXAMPLES": true,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "runtime-asan",
      "inherits": "runtime-test",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "ENGINE_SIM_SANITIZER": "address",
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "runtime-tsan",
      "inherits": "runtime-test",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "ENGINE_SIM_SANITIZER": "thread"
      }
    },
    {
      "name": "runtime-darwin-tsan",
      "inherits": "runtime-test",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "ENGINE_SIM_SANITIZER": "thread"
      }
    },
    {
      "name": "runtime-win-asan",
      "inherits": "runtime-test",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "RelWithDebInfo",
        "ENGINE_SIM_SANITIZER": "address"
      }
    },
    {
      "name": "runtime-static",
      "inherits": "runtime",
      "cacheVariables": {
        "ENGINE_SIM_RUNTIME_SHARED": false,
        "BUILD_TESTING": false,
        "ENGINE_SIM_BUILD_HOST_TESTS": false,
        "ENGINE_SIM_INSTALL_RUNTIME_EXAMPLE": false,
        "ENGINE_SIM_BUILD_RUNTIME_EXAMPLES": false
      }
    },
    {
      "name": "runtime-shared",
      "inherits": "runtime",
      "cacheVariables": {
        "ENGINE_SIM_RUNTIME_SHARED": true,
        "BUILD_TESTING": false,
        "ENGINE_SIM_BUILD_HOST_TESTS": false,
        "ENGINE_SIM_INSTALL_RUNTIME_EXAMPLE": false,
        "ENGINE_SIM_BUILD_RUNTIME_EXAMPLES": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "config",
      "configurePreset": "config",
      "configuration": "Release"
    },
    {
      "name": "physics",
      "configurePreset": "physics",
      "configuration": "Release",
      "targets": [
        "engine-sim-physics"
      ]
    },
    {
      "name": "synthesis",
      "configurePreset": "synthesis",
      "configuration": "Release",
      "targets": [
        "engine-sim-synthesis"
      ]
    },
    {
      "name": "core",
      "configurePreset": "core",
      "configuration": "Debug"
    },
    {
      "name": "core-release",
      "configurePreset": "core-release",
      "configuration": "Release"
    },
    {
      "name": "capture",
      "configurePreset": "capture",
      "configuration": "Release"
    },
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "configuration": "Release"
    },
    {
      "name": "desktop-windows",
      "configurePreset": "desktop-windows",
      "configuration": "Release"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "win-asan",
      "configurePreset": "win-asan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "desktop-asan",
      "configurePreset": "desktop-asan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "desktop-tsan",
      "configurePreset": "desktop-tsan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "runtime",
      "configurePreset": "runtime",
      "configuration": "Release"
    },
    {
      "name": "legacy-converter",
      "configurePreset": "legacy-converter",
      "configuration": "Release"
    },
    {
      "name": "runtime-test",
      "configurePreset": "runtime-test",
      "configuration": "Release"
    },
    {
      "name": "runtime-asan",
      "configurePreset": "runtime-asan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "runtime-tsan",
      "configurePreset": "runtime-tsan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "runtime-darwin-tsan",
      "configurePreset": "runtime-darwin-tsan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "runtime-static",
      "configurePreset": "runtime-static",
      "configuration": "Release"
    },
    {
      "name": "runtime-shared",
      "configurePreset": "runtime-shared",
      "configuration": "Release"
    },
    {
      "name": "runtime-win-asan",
      "configurePreset": "runtime-win-asan",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "core",
      "configurePreset": "core",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 90
      }
    },
    {
      "name": "core-release",
      "configurePreset": "core-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 90
      }
    },
    {
      "name": "capture",
      "configurePreset": "capture",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 90
      }
    },
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 90
      }
    },
    {
      "name": "desktop-windows",
      "configurePreset": "desktop-windows",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 90
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "RelWithDebInfo",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 600
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "configuration": "RelWithDebInfo",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:exitcode=66"
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 600
      }
    },
    {
      "name": "win-asan",
      "configurePreset": "win-asan",
      "configuration": "RelWithDebInfo",
      "environment": {},
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 600
      }
    },
    {
      "name": "desktop-asan",
      "inherits": "asan",
      "configurePreset": "desktop-asan"
    },
    {
      "name": "desktop-tsan",
      "inherits": "tsan",
      "configurePreset": "desktop-tsan",
      "filter": {
        "include": {
          "label": "desktop-audio|threaded|desktop-smoke-unit"
        }
      }
    },
    {
      "name": "runtime-test",
      "configurePreset": "runtime-test",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "r25-profile-combined"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "runtime-asan",
      "configurePreset": "runtime-asan",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "runtime-tsan",
      "configurePreset": "runtime-tsan",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:exitcode=66"
      }
    },
    {
      "name": "runtime-darwin-tsan",
      "configurePreset": "runtime-darwin-tsan",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:exitcode=66"
      },
      "filter": {
        "include": {
          "name": "^Fleet(IngressRace|TelemetryRace|Retirement|LifecycleEnvelopes|PauseAndTails|EpochRecovery|AdversarialThreads)$"
        }
      }
    },
    {
      "name": "runtime-win-asan",
      "configurePreset": "runtime-win-asan",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
