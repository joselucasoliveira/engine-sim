# The C SDK is a separate component from the desktop/capture data installation.
include(GNUInstallDirs)
include(CMakePackageConfigHelpers)
set(engine_sim_sdk_version 1.0.0)
set(engine_sim_sdk_destination "${CMAKE_INSTALL_LIBDIR}/cmake/EngineSimRuntime")
set(engine_sim_sdk_private "${CMAKE_INSTALL_LIBDIR}/engine-sim-runtime")
if (IS_ABSOLUTE "${CMAKE_INSTALL_LIBDIR}" OR IS_ABSOLUTE "${CMAKE_INSTALL_BINDIR}" OR IS_ABSOLUTE "${CMAKE_INSTALL_INCLUDEDIR}")
    message(FATAL_ERROR "The relocatable SDK requires relative GNUInstallDirs paths")
endif ()

set_property(GLOBAL PROPERTY ENGINE_SIM_SDK_INPUT_CHECKS "")
function(engine_sim_sdk_verify input)
    if (NOT EXISTS "${input}" OR "${input}" MATCHES "]===]")
        message(FATAL_ERROR "Missing or unsupported SDK input: ${input}")
    endif ()
    file(SHA256 "${input}" expected)
    set_property(GLOBAL APPEND_STRING PROPERTY ENGINE_SIM_SDK_INPUT_CHECKS
        "file(SHA256 [===[${input}]===] actual)\nif(NOT actual STREQUAL ${expected})\n  message(FATAL_ERROR [===[SDK input changed since configure: ${input}]===])\nendif()\n")
endfunction()
install(SCRIPT "${PROJECT_BINARY_DIR}/InstallSdkPreflight.cmake" COMPONENT RuntimeSDK)
engine_sim_sdk_verify("${PROJECT_SOURCE_DIR}/include/engine_sim/runtime.h")

foreach(target IN ITEMS engine-sim-runtime engine-sim engine-sim-script-interpreter simple-2d-constraint-solver piranha)
    set_target_properties(${target} PROPERTIES POSITION_INDEPENDENT_CODE ON
        CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN YES)
    if (MSVC)
        set_property(TARGET ${target} PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    endif ()
endforeach ()
set_target_properties(engine-sim-runtime PROPERTIES VERSION "${engine_sim_sdk_version}" SOVERSION 1)
if (ENGINE_SIM_RUNTIME_SHARED)
    target_compile_definitions(engine-sim-runtime PRIVATE ES_RUNTIME_BUILD)
    if (WIN32)
        target_sources(engine-sim-runtime PRIVATE "${PROJECT_SOURCE_DIR}/cmake/runtime.def")
        set_target_properties(engine-sim-runtime PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS OFF)
    elseif (APPLE)
        target_link_options(engine-sim-runtime PRIVATE "LINKER:-exported_symbols_list,${PROJECT_SOURCE_DIR}/cmake/runtime.macos.exports")
        set_target_properties(engine-sim-runtime PROPERTIES INSTALL_NAME_DIR "@rpath" INSTALL_RPATH "@loader_path")
        set_property(TARGET engine-sim-runtime APPEND PROPERTY LINK_DEPENDS "${PROJECT_SOURCE_DIR}/cmake/runtime.macos.exports")
    else ()
        target_link_options(engine-sim-runtime PRIVATE "LINKER:--version-script=${PROJECT_SOURCE_DIR}/cmake/runtime.elf.exports")
        set_target_properties(engine-sim-runtime PROPERTIES INSTALL_RPATH "$ORIGIN")
        set_property(TARGET engine-sim-runtime APPEND PROPERTY LINK_DEPENDS "${PROJECT_SOURCE_DIR}/cmake/runtime.elf.exports")
    endif ()
else ()
    target_compile_definitions(engine-sim-runtime PUBLIC ES_RUNTIME_STATIC)
    foreach(target IN ITEMS engine-sim engine-sim-script-interpreter simple-2d-constraint-solver piranha)
        install(FILES "$<TARGET_FILE:${target}>" DESTINATION "${engine_sim_sdk_private}" COMPONENT RuntimeSDK)
    endforeach ()
    set(engine_sim_sdk_boost_release "${Boost_FILESYSTEM_LIBRARY_RELEASE}")
    set(engine_sim_sdk_boost_debug "${Boost_FILESYSTEM_LIBRARY_DEBUG}")
    if (NOT EXISTS "${engine_sim_sdk_boost_release}")
        message(FATAL_ERROR "The static SDK needs the selected locked Boost filesystem archive")
    endif ()
    if (NOT EXISTS "${engine_sim_sdk_boost_debug}")
        set(engine_sim_sdk_boost_debug "${engine_sim_sdk_boost_release}")
    endif ()
    install(FILES "$<IF:$<CONFIG:Debug>,${engine_sim_sdk_boost_debug},${engine_sim_sdk_boost_release}>" DESTINATION "${engine_sim_sdk_private}"
        RENAME "${CMAKE_STATIC_LIBRARY_PREFIX}engine-sim-boost-filesystem${CMAKE_STATIC_LIBRARY_SUFFIX}" COMPONENT RuntimeSDK)
endif ()
install(TARGETS engine-sim-runtime
    RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}" COMPONENT RuntimeSDK
    LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT RuntimeSDK NAMELINK_COMPONENT RuntimeSDK
    ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT RuntimeSDK)
install(FILES "${PROJECT_SOURCE_DIR}/include/engine_sim/runtime.h"
    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}/engine_sim" COMPONENT RuntimeSDK)

# Generate only relative imported locations, without exporting internal build targets.
set(engine_sim_sdk_kind STATIC)
if (ENGINE_SIM_RUNTIME_SHARED)
    set(engine_sim_sdk_kind SHARED)
endif ()
set(engine_sim_sdk_link_file "$<TARGET_LINKER_FILE_NAME:engine-sim-runtime>")
set(engine_sim_sdk_runtime_file "$<TARGET_FILE_NAME:engine-sim-runtime>")
configure_package_config_file("${PROJECT_SOURCE_DIR}/cmake/EngineSimRuntimeConfig.cmake.in"
    "${PROJECT_BINARY_DIR}/EngineSimRuntimeConfig.cmake.gen"
    INSTALL_DESTINATION "${engine_sim_sdk_destination}")
file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/sdk-config/$<CONFIG>/EngineSimRuntimeConfig.cmake"
    INPUT "${PROJECT_BINARY_DIR}/EngineSimRuntimeConfig.cmake.gen")
write_basic_package_version_file("${PROJECT_BINARY_DIR}/EngineSimRuntimeConfigVersion.cmake"
    VERSION "${engine_sim_sdk_version}" COMPATIBILITY SameMajorVersion)
install(FILES "${PROJECT_BINARY_DIR}/sdk-config/$<CONFIG>/EngineSimRuntimeConfig.cmake"
    "${PROJECT_BINARY_DIR}/EngineSimRuntimeConfigVersion.cmake"
    DESTINATION "${engine_sim_sdk_destination}" COMPONENT RuntimeSDK)

function(engine_sim_sdk_notice path name)
    engine_sim_sdk_verify("${path}")
    install(FILES "${path}" DESTINATION "${CMAKE_INSTALL_DATADIR}/engine-sim-runtime/licenses"
        RENAME "${name}" COMPONENT RuntimeSDK)
endfunction()
engine_sim_sdk_notice("${PROJECT_SOURCE_DIR}/LICENSE" EngineSim-MIT.txt)
engine_sim_sdk_notice("${PROJECT_SOURCE_DIR}/THIRD_PARTY_NOTICES.md" THIRD_PARTY_NOTICES.md)
engine_sim_sdk_notice("${PROJECT_SOURCE_DIR}/dependencies/submodules/simple-2d-constraint-solver/LICENSE" Solver-MIT.txt)
engine_sim_sdk_notice("${PROJECT_SOURCE_DIR}/dependencies/submodules/piranha/LICENSE" Piranha-MIT.txt)
engine_sim_sdk_notice("${BOOST_ROOT}/LICENSE_1_0.txt" Boost.txt)
get_target_property(engine_sim_sdk_parser_includes piranha INCLUDE_DIRECTORIES)
set(engine_sim_sdk_flex_notice "")
foreach(directory IN LISTS engine_sim_sdk_parser_includes)
    if (EXISTS "${directory}/FlexLexer.h")
        set(engine_sim_sdk_flex_notice "${directory}/FlexLexer.h")
    endif ()
endforeach ()
engine_sim_sdk_notice("${engine_sim_sdk_flex_notice}" FlexLexer-notice.h)
if (ENGINE_SIM_INSTALL_RUNTIME_EXAMPLE)
    engine_sim_sdk_verify("${PROJECT_SOURCE_DIR}/cmake/runtime-example.json")
    file(READ "${PROJECT_SOURCE_DIR}/cmake/runtime-example.json" example_manifest)
    string(JSON example_count LENGTH "${example_manifest}" files)
    math(EXPR last "${example_count}-1")
    foreach(i RANGE 0 ${last})
        string(JSON path GET "${example_manifest}" files ${i} path)
        string(JSON expected GET "${example_manifest}" files ${i} sha256)
        set(input "${PROJECT_SOURCE_DIR}/examples/runtime/fixture/${path}")
        file(SHA256 "${input}" actual)
        if (NOT actual STREQUAL expected)
            message(FATAL_ERROR "Lawful runtime example changed: ${path}; review its allowlist")
        endif ()
        engine_sim_sdk_verify("${input}")
        get_filename_component(directory "${path}" DIRECTORY)
        install(FILES "${input}" DESTINATION "${CMAKE_INSTALL_DATADIR}/engine-sim-runtime/example/${directory}" COMPONENT RuntimeSDK)
    endforeach ()
endif ()
get_property(engine_sim_sdk_checks GLOBAL PROPERTY ENGINE_SIM_SDK_INPUT_CHECKS)
file(WRITE "${PROJECT_BINARY_DIR}/InstallSdkPreflight.cmake" "${engine_sim_sdk_checks}")
