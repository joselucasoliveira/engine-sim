@PACKAGE_INIT@
check_required_components(EngineSimRuntime)
if (DEFINED EngineSimRuntime_FOUND AND NOT EngineSimRuntime_FOUND)
    return()
endif ()
if (TARGET EngineSim::Runtime)
    return()
endif ()
file(REAL_PATH "${PACKAGE_PREFIX_DIR}" _engine_sim_prefix)

function(_engine_sim_sdk_file output relative)
    set(path "${_engine_sim_prefix}/${relative}")
    if (IS_ABSOLUTE "${relative}" OR NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "Missing or invalid EngineSim Runtime SDK file: ${relative}")
    endif ()
    file(REAL_PATH "${path}" real)
    cmake_path(IS_PREFIX _engine_sim_prefix "${real}" NORMALIZE inside)
    if (NOT inside)
        message(FATAL_ERROR "EngineSim Runtime SDK file escapes installed prefix: ${relative}")
    endif ()
    set(${output} "${path}" PARENT_SCOPE)
endfunction()

_engine_sim_sdk_file(_engine_sim_header "@CMAKE_INSTALL_INCLUDEDIR@/engine_sim/runtime.h")
_engine_sim_sdk_file(_engine_sim_linker "@CMAKE_INSTALL_LIBDIR@/@engine_sim_sdk_link_file@")
set(_engine_sim_library "${_engine_sim_linker}")
if ("@engine_sim_sdk_kind@" STREQUAL "STATIC")
    set(_engine_sim_archives "@engine_sim_sdk_archives@")
    foreach(name IN LISTS _engine_sim_archives)
        _engine_sim_sdk_file("_engine_sim_archive_${name}"
            "@engine_sim_sdk_private@/@CMAKE_STATIC_LIBRARY_PREFIX@${name}@CMAKE_STATIC_LIBRARY_SUFFIX@")
    endforeach ()
    include(CMakeFindDependencyMacro)
    find_dependency(Threads)
elseif (WIN32)
    _engine_sim_sdk_file(_engine_sim_library "@CMAKE_INSTALL_BINDIR@/@engine_sim_sdk_runtime_file@")
endif ()

add_library(EngineSim::Runtime @engine_sim_sdk_kind@ IMPORTED)
set_target_properties(EngineSim::Runtime PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_engine_sim_prefix}/@CMAKE_INSTALL_INCLUDEDIR@"
    IMPORTED_LOCATION "${_engine_sim_library}"
    IMPORTED_LINK_INTERFACE_LANGUAGES CXX)
if ("@engine_sim_sdk_kind@" STREQUAL "STATIC")
    set_property(TARGET EngineSim::Runtime PROPERTY INTERFACE_COMPILE_DEFINITIONS ES_RUNTIME_STATIC)
    set(_engine_sim_links)
    foreach(name IN LISTS _engine_sim_archives)
        set(target "EngineSimRuntime::Private_${name}")
        if (TARGET ${target})
            get_target_property(_engine_sim_existing_archive ${target} IMPORTED_LOCATION)
            if (NOT _engine_sim_existing_archive STREQUAL "${_engine_sim_archive_${name}}")
                message(FATAL_ERROR "EngineSim Runtime and C++ Config SDKs must use the same installation prefix: ${name}")
            endif ()
        else ()
            add_library(${target} STATIC IMPORTED)
            set_target_properties(${target} PROPERTIES
                IMPORTED_LOCATION "${_engine_sim_archive_${name}}"
                IMPORTED_LINK_INTERFACE_LANGUAGES CXX)
        endif ()
        string(CONCAT _engine_sim_link "$" "<LINK_ONLY:${target}>")
        list(APPEND _engine_sim_links "${_engine_sim_link}")
    endforeach ()
    string(CONCAT _engine_sim_thread_link "$" "<LINK_ONLY:Threads::Threads>")
    list(APPEND _engine_sim_links "${_engine_sim_thread_link}")
    set_property(TARGET EngineSim::Runtime PROPERTY INTERFACE_LINK_LIBRARIES "${_engine_sim_links}")
elseif (WIN32)
    set_property(TARGET EngineSim::Runtime PROPERTY IMPORTED_IMPLIB "${_engine_sim_linker}")
endif ()
