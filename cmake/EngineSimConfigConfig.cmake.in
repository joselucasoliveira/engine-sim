@PACKAGE_INIT@
set(EngineSimConfig_Config_FOUND TRUE)
set(EngineSimConfig_Json_FOUND @engine_sim_config_has_json@)
check_required_components(EngineSimConfig)
if (DEFINED EngineSimConfig_FOUND AND NOT EngineSimConfig_FOUND)
    return()
endif ()

file(REAL_PATH "${PACKAGE_PREFIX_DIR}" _engine_sim_config_prefix)
set(_engine_sim_config_headers "${_engine_sim_config_prefix}/@CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(_engine_sim_config_value_header "${_engine_sim_config_headers}/engine_sim/config-v1.hpp")
set_and_check(_engine_sim_config_validation_header "${_engine_sim_config_headers}/engine_sim/config-validation.hpp")
if (EngineSimConfig_Json_FOUND)
    set_and_check(_engine_sim_config_json_header "${_engine_sim_config_headers}/engine_sim/config-json.hpp")
endif ()

foreach(name IN ITEMS @engine_sim_config_targets@)
    set(target "EngineSimRuntime::Private_${name}")
    set_and_check(archive "${_engine_sim_config_prefix}/@engine_sim_config_private@/@CMAKE_STATIC_LIBRARY_PREFIX@${name}@CMAKE_STATIC_LIBRARY_SUFFIX@")
    if (TARGET ${target})
        get_target_property(location ${target} IMPORTED_LOCATION)
        if (NOT location STREQUAL archive)
            message(FATAL_ERROR "EngineSim Runtime and C++ Config SDKs must use the same installation prefix: ${name}")
        endif ()
    else ()
        add_library(${target} STATIC IMPORTED)
        set_target_properties(${target} PROPERTIES IMPORTED_LOCATION "${archive}" IMPORTED_LINK_INTERFACE_LANGUAGES CXX)
    endif ()
endforeach ()

if (NOT TARGET EngineSim::Config)
    add_library(EngineSim::Config INTERFACE IMPORTED)
    target_link_libraries(EngineSim::Config INTERFACE EngineSimRuntime::Private_engine-sim-config)
    target_include_directories(EngineSim::Config INTERFACE "${_engine_sim_config_headers}")
    target_compile_features(EngineSim::Config INTERFACE cxx_std_17)
endif ()
if (EngineSimConfig_Json_FOUND AND NOT TARGET EngineSim::Json)
    add_library(EngineSim::Json INTERFACE IMPORTED)
    target_link_libraries(EngineSim::Json INTERFACE EngineSimRuntime::Private_engine-sim-json EngineSim::Config)
endif ()
