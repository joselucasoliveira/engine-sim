if (TARGET engine-sim-capture OR TARGET engine-sim-app)
    find_package(Python3 3.9 COMPONENTS Interpreter REQUIRED)
    option(ENGINE_SIM_LOCAL_RESOURCE_STAGE "Permit explicitly private staging of original recordings" OFF)
    set(ENGINE_SIM_DELTA_ASSET_SOURCE "${PROJECT_SOURCE_DIR}/dependencies/submodules/delta-studio"
        CACHE PATH "Pinned Delta runtime data input")
    set(engine_sim_stage_desktop "")
    if (TARGET engine-sim-app)
        set(engine_sim_stage_desktop --desktop)
    endif ()
    set(engine_sim_extra_input_checks "")
    macro(engine_sim_verify_runtime_input input)
        if (NOT EXISTS "${input}" OR "${input}" MATCHES "]==]")
            message(FATAL_ERROR "Missing or unsupported runtime input: ${input}")
        endif ()
        file(SHA256 "${input}" input_hash)
        string(APPEND engine_sim_extra_input_checks
            "file(SHA256 [==[${input}]==] actual_hash)\nif(NOT actual_hash STREQUAL ${input_hash})\n"
            "  message(FATAL_ERROR [==[Runtime input changed since configure: ${input}]==])\nendif()\n")
    endmacro()
    macro(engine_sim_install_notice input name)
        engine_sim_verify_runtime_input("${input}")
        install(FILES "${input}" DESTINATION share/engine-sim/licenses RENAME "${name}" COMPONENT Runtime)
    endmacro()
    # The data/rights preflight runs before any executable or runtime library copy.
    install(SCRIPT "${PROJECT_BINARY_DIR}/InstallRuntimeData.cmake" COMPONENT Runtime)
    if (TARGET engine-sim-capture)
        install(TARGETS engine-sim-capture RUNTIME DESTINATION bin COMPONENT Runtime)
        install(FILES "${PROJECT_BINARY_DIR}/tools/capture/capture_cli.py"
            "${PROJECT_BINARY_DIR}/tools/capture/capture_metrics.py"
            "${PROJECT_BINARY_DIR}/tools/capture/build.txt"
            DESTINATION share/engine-sim/tools/capture COMPONENT Runtime)
    endif ()
    if (TARGET engine-sim-app)
        install(TARGETS engine-sim-app RUNTIME DESTINATION bin BUNDLE DESTINATION . COMPONENT Runtime)
        install(FILES "${PROJECT_SOURCE_DIR}/tools/run_desktop_smoke.py"
            DESTINATION share/engine-sim/tools COMPONENT Runtime)
        if (WIN32)
            foreach(input IN LISTS windows_runtime)
                engine_sim_verify_runtime_input("${input}")
            endforeach ()
            install(FILES ${windows_runtime} DESTINATION bin COMPONENT Runtime)
            install(FILES "${PROJECT_SOURCE_DIR}/configuration/delta.conf" DESTINATION bin COMPONENT Runtime)
            engine_sim_install_notice("${ENGINE_SIM_D3DX_NOTICE}" DirectX-SDK.txt)
            get_filename_component(engine_sim_sdl_root "${SDL2_INCLUDE_DIR}" DIRECTORY)
            get_filename_component(engine_sim_sdl_image_root "${SDL2_IMAGE_INCLUDE_DIR}" DIRECTORY)
            engine_sim_install_notice("${engine_sim_sdl_root}/LICENSE.txt" SDL2.txt)
            engine_sim_install_notice("${engine_sim_sdl_image_root}/LICENSE.txt" SDL2_image.txt)
        else ()
            engine_sim_install_notice("${ENGINE_SIM_SDL3_SOURCE}/LICENSE.txt" SDL3.txt)
        endif ()
        if (APPLE)
            set_target_properties(engine-sim-app PROPERTIES MACOSX_BUNDLE TRUE OUTPUT_NAME EngineSim
                INSTALL_RPATH "@loader_path/../Frameworks")
        elseif (UNIX)
            set_target_properties(engine-sim-app PROPERTIES INSTALL_RPATH "$ORIGIN/../lib")
        endif ()
    endif ()
    engine_sim_install_notice("${PROJECT_SOURCE_DIR}/dependencies/submodules/simple-2d-constraint-solver/LICENSE" solver-MIT.txt)
    if (PIRANHA_ENABLED)
        engine_sim_install_notice("${PROJECT_SOURCE_DIR}/dependencies/submodules/piranha/LICENSE" Piranha-MIT.txt)
        engine_sim_install_notice("${BOOST_ROOT}/LICENSE_1_0.txt" Boost.txt)
        get_target_property(engine_sim_parser_includes piranha INCLUDE_DIRECTORIES)
        set(engine_sim_flex_notice "")
        foreach(directory IN LISTS engine_sim_parser_includes)
            if (EXISTS "${directory}/FlexLexer.h")
                set(engine_sim_flex_notice "${directory}/FlexLexer.h")
            endif ()
        endforeach ()
        if (NOT engine_sim_flex_notice)
            message(FATAL_ERROR "Cannot locate the FlexLexer header/notice used by this parser")
        endif ()
        engine_sim_install_notice("${engine_sim_flex_notice}" FlexLexer-notice.h)
    endif ()
    configure_file("${PROJECT_SOURCE_DIR}/cmake/InstallRuntimeData.cmake.in"
        "${PROJECT_BINARY_DIR}/InstallRuntimeData.cmake" @ONLY)
    configure_file("${PROJECT_SOURCE_DIR}/cmake/InstallRuntimeInventory.cmake.in"
        "${PROJECT_BINARY_DIR}/InstallRuntimeInventory.cmake" @ONLY)
    install(SCRIPT "${PROJECT_BINARY_DIR}/InstallRuntimeInventory.cmake" COMPONENT Runtime)
endif ()
