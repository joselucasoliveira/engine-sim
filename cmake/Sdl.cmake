# SDL is a private, source-built Unix desktop dependency; core/capture never acquire it.
if (NOT EXISTS "${ENGINE_SIM_SDL3_SOURCE}/CMakeLists.txt")
    message(FATAL_ERROR "Missing locked SDL3 source. Run tools/bootstrap.py --profile desktop.")
endif ()
file(READ "${ENGINE_SIM_SDL3_SOURCE}/include/SDL3/SDL_version.h" engine_sim_sdl_version)
foreach(component IN ITEMS MAJOR MINOR MICRO)
    if (component STREQUAL "MAJOR")
        set(expected 3)
    elseif (component STREQUAL "MINOR")
        set(expected 2)
    else ()
        set(expected 8)
    endif ()
    if (NOT engine_sim_sdl_version MATCHES "#define SDL_${component}_VERSION[ \t]+${expected}([\r\n]|$)")
        message(FATAL_ERROR "The desktop requires the locked SDL 3.2.8 source")
    endif ()
endforeach ()
enable_language(C)
set(SDL_SHARED OFF CACHE BOOL "Build SDL privately" FORCE)
set(SDL_STATIC ON CACHE BOOL "Build SDL privately" FORCE)
set(SDL_TEST_LIBRARY OFF CACHE BOOL "No dependency test library" FORCE)
set(SDL_TESTS OFF CACHE BOOL "No dependency tests" FORCE)
set(SDL_EXAMPLES OFF CACHE BOOL "No dependency examples" FORCE)
set(SDL_INSTALL OFF CACHE BOOL "No SDL SDK installation" FORCE)
add_subdirectory("${ENGINE_SIM_SDL3_SOURCE}" sdl3 EXCLUDE_FROM_ALL)
# SDL generates its own export set even with installation disabled. Copy the selected
# instrumentation flags without exporting our private diagnostics target through SDL.
get_target_property(engine_sim_sdl_diagnostics engine-sim-diagnostics INTERFACE_COMPILE_OPTIONS)
if (engine_sim_sdl_diagnostics)
    foreach(target IN ITEMS SDL3-static SDL_uclibc)
        if (TARGET ${target})
            target_compile_options(${target} PRIVATE ${engine_sim_sdl_diagnostics})
        endif ()
    endforeach ()
endif ()
add_library(engine-sim-sdl-window STATIC "${PROJECT_SOURCE_DIR}/src/sdl_window.cpp")
target_link_libraries(engine-sim-sdl-window PUBLIC engine-sim-host PRIVATE SDL3::SDL3-static)
target_compile_features(engine-sim-sdl-window PUBLIC cxx_std_17)
if (BUILD_TESTING)
    add_executable(engine-sim-sdl-window-test "${PROJECT_SOURCE_DIR}/test/sdl_window_tests.cpp")
    target_link_libraries(engine-sim-sdl-window-test PRIVATE engine-sim-sdl-window SDL3::SDL3-static gtest)
    # Listing tests must not initialize a display, including cross/disconnected discovery.
    gtest_discover_tests(engine-sim-sdl-window-test DISCOVERY_TIMEOUT 30
        PROPERTIES LABELS desktop-input TIMEOUT 45 RUN_SERIAL TRUE)
endif ()
if (TARGET engine-sim-app)
    install(FILES "${ENGINE_SIM_SDL3_SOURCE}/LICENSE.txt"
        DESTINATION share/engine-sim/licenses RENAME SDL3.txt COMPONENT Runtime)
endif ()
