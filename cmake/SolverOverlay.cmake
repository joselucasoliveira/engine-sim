# The solver sources include adjacent headers using relative paths. Project
# that same layout in the binary tree so every TU sees the same inline code.
function(engine_sim_project_solver output original)
    set(lock "${PROJECT_SOURCE_DIR}/cmake/dependencies.lock.json")
    set(patch "${PROJECT_SOURCE_DIR}/dependencies/patches/solver-reservation.patch")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${patch}")
    if (NOT TARGET engine-sim-json)
        # The JSON module already tracks this lock in combined profiles.
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${lock}")
    endif ()
    string(JSON expected GET "${engine_sim_dependency_lock}" solver_overlay revision)
    string(JSON pinned GET "${engine_sim_dependency_lock}" git simple-2d-constraint-solver revision)
    if (NOT expected STREQUAL pinned)
        message(FATAL_ERROR "Solver workspace overlay applies to ${expected}, not locked revision ${pinned}")
    endif ()
    string(JSON expected GET "${engine_sim_dependency_lock}" solver_overlay patch_sha256)
    file(READ "${patch}" patch_text)
    string(REPLACE "\r\n" "\n" patch_text "${patch_text}")
    string(SHA256 actual "${patch_text}")
    if (NOT actual STREQUAL expected)
        message(FATAL_ERROR "Solver workspace patch hash differs from the dependency lock")
    endif ()

    set(projected "${CMAKE_CURRENT_BINARY_DIR}/solver-overlay/engine_sim_solver")
    set(scratch "${CMAKE_CURRENT_BINARY_DIR}/solver-overlay-input")
    set(patched src/matrix.cpp include/sparse_matrix.h)
    file(GLOB_RECURSE sources LIST_DIRECTORIES FALSE RELATIVE "${original}"
        "${original}/include/*" "${original}/src/*")
    foreach (path IN LISTS sources)
        if (NOT path IN_LIST patched)
            configure_file("${original}/${path}" "${projected}/${path}" COPYONLY)
        endif ()
    endforeach ()
    foreach (path IN LISTS patched)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}/${path}")
        string(JSON expected GET "${engine_sim_dependency_lock}" solver_overlay files "${path}" input_sha256)
        file(READ "${original}/${path}" input)
        string(REPLACE "\r\n" "\n" input "${input}")
        string(SHA256 actual "${input}")
        if (NOT actual STREQUAL expected)
            message(FATAL_ERROR "Locked solver overlay input ${path} has unexpected hash ${actual}")
        endif ()
        file(WRITE "${scratch}/${path}" "${input}")
    endforeach ()
    file(WRITE "${scratch}/reservation.patch" "${patch_text}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -c core.autocrlf=false apply --no-index --unidiff-zero --whitespace=error
        -- "${scratch}/reservation.patch" WORKING_DIRECTORY "${scratch}" COMMAND_ERROR_IS_FATAL ANY)
    foreach (path IN LISTS patched)
        string(JSON expected GET "${engine_sim_dependency_lock}" solver_overlay files "${path}" output_sha256)
        file(SHA256 "${scratch}/${path}" actual)
        if (NOT actual STREQUAL expected)
            message(FATAL_ERROR "Solver overlay output ${path} has unexpected hash ${actual}")
        endif ()
        configure_file("${scratch}/${path}" "${projected}/${path}" COPYONLY)
    endforeach ()
    set("${output}" "${projected}" PARENT_SCOPE)
endfunction()
