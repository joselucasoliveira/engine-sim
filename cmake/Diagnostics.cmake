set(ENGINE_SIM_SANITIZER "none" CACHE STRING "Runtime diagnostics: none, address, or thread")
set_property(CACHE ENGINE_SIM_SANITIZER PROPERTY STRINGS none address thread)
if (NOT ENGINE_SIM_SANITIZER MATCHES "^(none|address|thread)$")
    message(FATAL_ERROR "Choose one sanitizer: none, address, or thread")
endif ()

add_library(engine-sim-diagnostics INTERFACE)
if (NOT ENGINE_SIM_SANITIZER STREQUAL "none")
    if (MSVC)
        if (NOT ENGINE_SIM_SANITIZER STREQUAL "address" OR NOT engine_sim_windows)
            message(FATAL_ERROR "MSVC diagnostics require Windows x64 and the address sanitizer")
        endif ()
        # This configuration deliberately excludes Debug's /RTC1 and /ZI.
        set(CMAKE_CXX_FLAGS_RELWITHDEBINFO "/O1 /Zi /DNDEBUG" CACHE STRING "ASan compiler flags" FORCE)
        set(CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO "/DEBUG /INCREMENTAL:NO" CACHE STRING "ASan linker flags" FORCE)
        target_compile_options(engine-sim-diagnostics INTERFACE /fsanitize=address /Zi)
        target_link_options(engine-sim-diagnostics INTERFACE /INCREMENTAL:NO)
    elseif (CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
        if (ENGINE_SIM_SANITIZER STREQUAL "address")
            set(runtime address,undefined)
            target_compile_options(engine-sim-diagnostics INTERFACE -fno-sanitize-recover=all)
        else ()
            if (NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" AND
                    NOT (APPLE AND CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang" AND CMAKE_SYSTEM_PROCESSOR STREQUAL "arm64"))
                message(FATAL_ERROR "Thread diagnostics require Linux or native arm64 AppleClang")
            endif ()
            set(runtime thread)
        endif ()
        target_compile_options(engine-sim-diagnostics INTERFACE -g -O1 -fno-omit-frame-pointer "-fsanitize=${runtime}")
        target_link_options(engine-sim-diagnostics INTERFACE "-fsanitize=${runtime}")
    else ()
        message(FATAL_ERROR "Unsupported compiler for runtime diagnostics")
    endif ()
endif ()

function(engine_sim_diagnose target first_party)
    if (NOT TARGET "${target}")
        return()
    endif ()
    target_link_libraries("${target}" PRIVATE engine-sim-diagnostics)
    if (first_party)
        if (MSVC)
            target_compile_options("${target}" PRIVATE /W4 /we4700 /we4715)
        else ()
            target_compile_options("${target}" PRIVATE -Wall -Wextra -Wpedantic
                -Werror=return-type -Werror=uninitialized -Werror=array-bounds -Werror=null-dereference)
        endif ()
    endif ()
endfunction()
